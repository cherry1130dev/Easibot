# ==============================================================================
# Easibot: AI-Powered Multilingual Interactive Assistant Robot Configuration
# ==============================================================================

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Default: gemini-3.5-flash-lite for ultra-fast multimodal & code-mixed processing)
GEMINI_MODEL=gemini-3.5-flash-lite

# Hardware Mode:
# Set to 'true' when running on Windows/Laptop/Mac without Raspberry Pi GPIO/SPI.
# Set to 'false' on the Raspberry Pi Zero 2 W with physical ILI9341 & HC-SR04.
MOCK_HARDWARE=true

# Ultrasonic Sensor Settings
WAKE_DISTANCE_CM=60.0
ULTRASONIC_COOLDOWN_SEC=15.0

# Language Preference: 'auto', 'en', 'te', or 'hi'
DEFAULT_LANGUAGE=auto

# Audio Settings
RECORD_DURATION_SEC=5.0
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
ENABLE_SPEAKER_BY_DEFAULT=true

# Web Server Settings
WEB_HOST=0.0.0.0
WEB_PORT=5000
FLASK_DEBUG=false
