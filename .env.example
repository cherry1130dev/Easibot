# ==============================================================================
# Easibot: AI-Powered Multilingual Interactive Assistant Robot Configuration
# ==============================================================================

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Default: gemini-3.5-flash-lite for fast multimodal & code-mixed replies)
GEMINI_MODEL=gemini-3.5-flash-lite

# Hardware Mode: 'true' on Laptop/Windows, 'false' on Raspberry Pi
MOCK_HARDWARE=false

# Ultrasonic Sensor Pins (BCM) & Trigger Range (10-15 cm close range)
PIN_TRIG=23
PIN_ECHO=27
WAKE_MIN_CM=2.0
WAKE_DISTANCE_CM=15.0
ULTRASONIC_COOLDOWN_SEC=15.0

# Language Preference: 'auto', 'en', 'te', or 'hi'
DEFAULT_LANGUAGE=auto

# Audio Settings
LISTEN_TIMEOUT_SEC=5.0
RECORD_DURATION_SEC=7.0
ENABLE_SPEAKER_BY_DEFAULT=true
