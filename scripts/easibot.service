[Unit]
Description=Easibot AI Multilingual Assistant Robot
After=network-online.target sound.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/Easibot
ExecStart=/home/admin/Easibot/scripts/run_service.sh main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=multi-user.target
