[Unit]
Description=Easibot AI Multilingual Assistant Robot
After=network-target sound.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/Easibot
ExecStart=/home/admin/Easibot/venv/bin/python3 /home/admin/Easibot/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
